// Ela & Co. — data model (Postgres / Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Customers authenticate via WhatsApp OTP (phone is the identity).
model Customer {
  id            String         @id @default(cuid())
  phone         String         @unique
  name          String?
  address       String? // saved delivery address / landmark
  notes         String? // admin CRM notes
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  orders        Order[]
  tickets       Ticket[]
  subscriptions Subscription[]
}

/// One-time passwords for customer login.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum StaffRole {
  ADMIN
  KITCHEN
}

/// Admin + kitchen staff authenticate with username + password.
model StaffUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String?
  role         StaffRole @default(KITCHEN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

/// Menu is managed by admin, shown to customers.
model MenuItem {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  price           Int // whole rupees (MRP, before discount)
  discountPercent Int      @default(0) // 0-90 % off
  category        String   @default("Meals")
  tag             String?
  spice           Int      @default(1) // 0-3 chilli level
  imageUrl        String?
  available       Boolean  @default(true)
  stock           Int? // null = unlimited; else remaining orderable quantity
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
}

enum OrderStatus {
  PENDING // created, awaiting payment
  PLACED // paid / confirmed, waiting for kitchen
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

model Order {
  id         String    @id @default(cuid())
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  customerName  String
  customerPhone String
  address       String
  notes         String?

  deliveryLocation   DeliveryLocation? @relation(fields: [deliveryLocationId], references: [id])
  deliveryLocationId String?

  items OrderItem[]

  subtotal           Int // sum of discounted line prices
  discountTotal      Int     @default(0) // total saved vs MRP
  couponCode         String?
  couponDiscount     Int     @default(0) // saved via coupon
  membershipDiscount Int     @default(0) // saved via active subscription
  deliveryFee        Int     @default(0)
  total              Int

  invoiceNo String? @unique
  source    String  @default("web") // web | manual (admin-created invoice)

  status        OrderStatus   @default(PENDING)
  paymentMethod String        @default("razorpay") // razorpay | cod | manual
  paymentStatus PaymentStatus @default(UNPAID)

  razorpayOrderId   String?
  razorpayPaymentId String?

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id         String    @id @default(cuid())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  menuItemId String?
  name       String
  mrp        Int       @default(0) // original unit price
  price      Int // discounted unit price actually charged
  qty        Int

  @@index([orderId])
}

/// Singleton store configuration (admin can stop taking orders).
model StoreSetting {
  id              Int      @id @default(1)
  acceptingOrders Boolean  @default(true)
  closedMessage   String?
  updatedAt       DateTime @updatedAt
}

/// Atomic counters (e.g. sequential invoice numbers).
model Counter {
  name  String @id
  value Int    @default(0)
}

/// Immutable audit trail — one row per mutating action across the system.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorType  String // admin | kitchen | customer | system
  actorId    String?
  actorLabel String? // username / phone / name for readability

  action     String // e.g. order.status_changed, menu.updated, auth.staff_login
  entityType String? // order | menuItem | staffUser | storeSetting | auth
  entityId   String?

  summary  String? // human-readable one-liner
  metadata Json? // structured before/after + context

  ip        String?
  userAgent String?

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
}

/// Delivery areas the store serves (admin-managed). Replaces free-text address.
model DeliveryLocation {
  id          String   @id @default(cuid())
  name        String // e.g. "Pattom"
  area        String? // optional sub-area / description
  deliveryFee Int      @default(40)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  orders Order[]
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Discount coupons applied at checkout (admin-managed).
model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType @default(PERCENT)
  value        Int // percent (0-100) or fixed rupees
  minOrder     Int? // minimum subtotal to qualify
  maxDiscount  Int? // cap on the discount (percent coupons)
  usageLimit   Int? // null = unlimited total redemptions
  usedCount    Int          @default(0)
  active       Boolean      @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Website testimonials (admin-managed).
model Review {
  id         String   @id @default(cuid())
  authorName String
  location   String?
  rating     Int      @default(5) // 1-5
  body       String
  published  Boolean  @default(true)
  source     String   @default("manual") // manual | collected
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([published])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

/// Customer support / complaint tickets.
model Ticket {
  id            String       @id @default(cuid())
  ticketNo      String       @unique
  customer      Customer?    @relation(fields: [customerId], references: [id])
  customerId    String?
  customerName  String
  customerPhone String
  category      String // Order Issue | Payment Issue | Delivery Issue | Refund Request | Technical Issue | Feedback | Other
  subject       String
  order         Order?       @relation(fields: [orderId], references: [id])
  orderId       String?
  status        TicketStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  messages TicketMessage[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

enum PlanInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Membership plans customers can subscribe to (admin-managed).
model SubscriptionPlan {
  id              String       @id @default(cuid())
  name            String
  description     String       @default("")
  price           Int // whole rupees charged each billing cycle
  interval        PlanInterval @default(MONTHLY)
  intervalCount   Int          @default(1) // e.g. every 1 month
  discountPercent Int          @default(0) // auto-applied to every order
  freeDelivery    Boolean      @default(true)
  benefits        String[] // bullet points shown on the plan card
  active          Boolean      @default(true)
  sortOrder       Int          @default(0)
  razorpayPlanId  String? // set when mirrored into Razorpay
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  CREATED // awaiting the customer's first authorisation
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

/// A customer's membership. Billing (eMandate/AutoPay) is handled by Razorpay.
model Subscription {
  id         String           @id @default(cuid())
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  planId     String

  status                 SubscriptionStatus @default(CREATED)
  razorpaySubscriptionId String?            @unique
  razorpayPaymentId      String?

  startedAt   DateTime?
  currentEnd  DateTime? // next renewal date
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges SubscriptionCharge[]

  @@index([customerId])
  @@index([status])
}

/// One row per successful recurring charge (payment history).
model SubscriptionCharge {
  id                String       @id @default(cuid())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId    String
  amount            Int // whole rupees
  razorpayPaymentId String?      @unique
  paidAt            DateTime     @default(now())

  @@index([subscriptionId])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  authorType  String // customer | staff | system
  authorLabel String?
  body        String
  internal    Boolean  @default(false) // admin-only internal note (hidden from customer)
  createdAt   DateTime @default(now())

  @@index([ticketId])
}
