# ============================================================
#  Ela & Co. — environment variables (copy to .env and fill in)
# ============================================================

# ---- Database (Neon / Postgres) ----
# Neon → Project dashboard → "Connection string" widget.
#   DATABASE_URL = POOLED string   → host contains "-pooler"
#   DIRECT_URL   = DIRECT string    → toggle "Connection pooling" OFF (no "-pooler")
# Both must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Auth ----
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Hardcoded admin login (username + password). CHANGE THESE.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-admin-password"

# ---- Razorpay (Standard Checkout) ----
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Public — safe to expose to the browser. KEY_SECRET must NEVER be prefixed with NEXT_PUBLIC.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Required for MEMBERSHIP auto-renewals. Razorpay → Settings → Webhooks → add
#   URL:    https://YOUR-DOMAIN/api/webhooks/razorpay
#   Events: subscription.charged, subscription.activated, subscription.halted,
#           subscription.paused, subscription.resumed, subscription.cancelled,
#           subscription.completed
# Paste the secret you set there here. Without it, renewals won't extend memberships.
RAZORPAY_WEBHOOK_SECRET=""

# ---- WhatsApp Cloud API (OTP delivery) ----
WHATSAPP_TOKEN="your_meta_graph_api_token"
# Numeric Phone Number ID from Meta → WhatsApp → API Setup (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=""
# Approved authentication (OTP) template name (leave blank to send a plain text message).
WHATSAPP_TEMPLATE_NAME="ela_co_otp_auth"
WHATSAPP_TEMPLATE_LANG="en"
# Restaurant's public WhatsApp contact number (used for the floating chat button).
NEXT_PUBLIC_WHATSAPP_NUMBER="917907577979"
# Owner's personal WhatsApp for new-order alerts (must differ from the sending number). Blank = off.
ADMIN_NOTIFY_PHONE=""

# When true (or when WHATSAPP_PHONE_NUMBER_ID is empty), OTPs are printed to the
# server console instead of / in addition to being sent, so you can test locally.
OTP_DEV_MODE="true"

# Public site URL (used for SEO metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
